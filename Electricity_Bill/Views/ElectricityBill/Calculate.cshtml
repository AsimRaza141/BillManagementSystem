@model Electricity_Bill.Models.BillCalculationViewModel

@{
    ViewData["Title"] = "Calculate Bill";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 style="text-align: center; color: #007bff; font-weight: bold;">@ViewData["Title"]</h2>
<div>
    <form asp-controller="ElectricityBill" asp-action="GenerateBillReport" method="get" class="mb-4">
        <div class="form-row">
            <div class="col">
                <label for="startDate">Start Date</label>
                <input type="date" asp-for="StartDate" class="form-control" required>
            </div>
            <div class="col">
                <label for="endDate">End Date</label>
                <input type="date" asp-for="EndDate" class="form-control" required>
            </div>
            <div class="col">
                <label for="referenceNumber">Reference Number:</label>
                <input type="text" asp-for="ReferenceNumber" class="form-control">
            </div>
        </div>
        <button type="submit" class="btn btn-success" style="margin-top: 20px; padding: 8px 12px; font-size: 14px;">Generate Report</button>

    </form>
</div>
<div>
    <form asp-action="CalculateBill" method="post">
        <div class="form-row" style="display: flex; justify-content: center; align-items: end;">
            <div class="form-group col-md-4">
                <label for="SelectedSiteId">Select Site</label>
                <select asp-for="SelectedSiteId" asp-items="@(new SelectList(Model.Sites, "Id", "SiteName"))" class="form-control" required>
                    <option value="">-- Select Site --</option>
                </select>
            </div>

            <div class="form-group col-md-4">
                <label for="SelectedReferenceNumber">Select Reference Number</label>
                <select asp-for="SelectedReferenceNumber" asp-items="@(new SelectList(Model.ReferenceNumbers))" class="form-control" required>
                    <option value="">-- Select Reference Number --</option>
                </select>
            </div>
        </div>

        <div class="form-row" style="display: flex; justify-content: center;">
            <div class="form-group col-md-2">
                <label asp-for="Year">Year</label>
                <input asp-for="Year" class="form-control" type="number" required />
            </div>
            <div class="form-group col-md-2">
                <label asp-for="Month">Month</label>
                <input asp-for="Month" class="form-control" type="number" required />
            </div>
            <div class="form-group col-md-2">
                <label asp-for="PreviousReading">Previous Reading</label>
                <input asp-for="PreviousReading" class="form-control" type="number" required />
            </div>
            <div class="form-group col-md-2">
                <label asp-for="CurrentReading">Current Reading</label>
                <input asp-for="CurrentReading" class="form-control" type="number" required />
            </div>
        </div>

        <button type="submit" class="btn btn-info" style="margin-top: 10px; margin-left: auto; margin-right: auto; display: block;padding: 8px 12px; font-size: 14px;">Calculate</button>
    </form>
</div>

@if (Model.Bills != null && Model.Bills.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Date & Time</th>
                <th>Reference Number</th>
                <th>Site</th>
                <th>Previous Reading</th>
                <th>Current Reading</th>
                <th>Net Reading</th>
                <th>Month</th>
                <th>Year</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var bill in Model.Bills)
            {
                <tr>
                    <td>@bill.Date.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td>@bill.ReferenceNumber</td>
                    <td>@bill.SiteName</td>
                    <td>@bill.PreviousReading</td>
                    <td>@bill.CurrentReading</td>
                    <td>@bill.NetReading</td>
                    <td>@bill.Month</td>
                    <td>@bill.Year</td>

                    <td>
                        <div style="display: flex; align-items: center; justify-content: start;">
                            <form asp-action="DeleteBill" asp-route-id="@bill.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this record?');">
                                <button type="submit" class="btn btn-danger" style="padding: 6px 10px; font-size: 12px;">Delete</button>
                            </form>
                            <form asp-action="EditBill" asp-route-id="@bill.Id" method="get" style="margin-left: 10px;">
                                <button type="submit" class="btn btn-primary" style="padding: 6px 10px; font-size: 12px;">Edit</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No bills found. Please calculate and add a bill.</p>
}

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
